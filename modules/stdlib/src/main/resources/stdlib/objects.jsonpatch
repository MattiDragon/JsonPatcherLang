import "@internals" as internals;

# @@doc_namespace std

#| global library objects
#| Provides utilities for working with objects.

#| property objects.keys: (object: object) -> string[]
#| Returns the list of keys in a object.
function keys(object) {
    debug.assert(object is object, "Can only get keys of object");
    return internals.keys(object);
}

$keys = keys;
