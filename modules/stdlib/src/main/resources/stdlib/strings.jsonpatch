import "@internals" as internals;
import "@internals/reflection" as reflectionInternals;

# @@doc_namespace std

val ROOT_LOCALE = reflectionInternals.findClass("java.util.Locale").ROOT;

function _unwrap(s) {
    debug.assert(s is string, "Expected first argument to string function to be string");
    return reflectionInternals.unwrapValue(s);
}

#| global library strings
#| Provides utilities for manipulating strings. Many of the methods in this module can be used as methods.

#| property strings.asString: (value: any) -> string
#| Converts any value to a string
function asString(value) {
    return reflectionInternals.forceWrap(value).'toString()Ljava/lang/String;'();
}
$asString = asString;

#| property strings.matches: (string: string, regex: string) -> boolean
#| Checks if the whole string matches a specific regular expression.
#| @method string
function matches(string, regex) {
    debug.assert(regex is string, "Regex must be a string");
    return _unwrap(string).matches(regex);
}
$matches = matches;

#| property strings.replace: (string: string, pattern: string, replacement: string) -> string
#| Replaces all instances of `pattern` in `string` with `replacement`.
#| @method string
function replace(string, pattern, replacement) {
    debug.assert(pattern is string, "Pattern must be a string");
    debug.assert(replacement is string, "Replacement must be a string");
    return _unwrap(string).'replace(Ljava/lang/CharSequence;Ljava/lang/CharSequence;)Ljava/lang/String;'(pattern, replacement);
}
$replace = replace;

#| property strings.replaceRegex: (string: string, pattern: string, replacement: string) -> string
#| Replaces all matches of the regular expression `pattern` in `string` with `replacement`.
#| @method string
function replaceRegex(string, pattern, replacement) {
    debug.assert(pattern is string, "Pattern must be a string");
    debug.assert(replacement is string, "Replacement must be a string");
    return _unwrap(string).replaceAll(pattern, replacement);
}
$replaceRegex = replaceRegex;

#| property strings.split: (string: string, delimiter: string) -> array
#| Splits the string into into an array with the specified delimiter
#| @method string
function split(string, delimiter) {
    debug.assert(delimiter is string, "Delimiter must be a string");
    val jArray = _unwrap(string).'split(Ljava/lang/String;)[Ljava/lang/String;'(delimiter);
    val array = [];
    for (var i = 0; i < jArray.length; i++) {
        array.push(jArray[i]);
    }
    return array;
}
$split = split;

#| property strings.toLowerCase: (string: string) -> string
#| Converts the string to lowercase with the root locale
#| @method string
function toLowerCase(string) {
    return _unwrap(string).'toLowerCase(Ljava/util/Locale;)Ljava/lang/String;'(ROOT_LOCALE);
}
$toLowerCase = toLowerCase;

#| property strings.toUpperCase: (string: string) -> string
#| Converts the string to uppercase with the root locale
#| @method string
function toUpperCase(string) {
    return _unwrap(string).'toUpperCase(Ljava/util/Locale;)Ljava/lang/String;'(ROOT_LOCALE);
}
$toUpperCase = toUpperCase;

#| property strings.trim: (string: string) -> string
#| Trim the string by removing leading and trailing whitespace
#| @method string
function trim(string) {
    return _unwrap(string).strip();
}
$trim = trim;

#| property strings.trimStart: (string: string) -> string
#| Trim the string by removing leading whitespace
#| @method string
function trimStart(string) {
    return _unwrap(string).stripLeading();
}
$trimStart = trimStart;

#| property strings.trimEnd: (string: string) -> string
#| Trim the string by removing trailing whitespace
#| @method string
function trimEnd(string) {
    return _unwrap(string).stripTrailing();
}
$trimEnd = trimEnd;

#| property strings.startsWith: (string: string, prefix: string) -> boolean
#| Returns true if the string starts with the specified prefix
#| @method string
function startsWith(string, prefix) {
    debug.assert(prefix is string, "Prefix must be a string");
    return _unwrap(string).'startsWith(Ljava/lang/String;)Z'(prefix);
}
$startsWith = startsWith;

#| property strings.endsWith: (string: string, suffix: string) -> boolean
#| Returns true if the string ends with the specified suffix
#| @method string
function endsWith(string, suffix) {
    debug.assert(suffix is string, "Suffix must be a string");
    return _unwrap(string).endsWith(suffix);
}
$endsWith = endsWith;

#| property strings.contains: (string: string, substring: string) -> boolean
#| Returns true if the string contains the specified substring
#| @method string
function contains(string, substring) {
    debug.assert(substring is string, "Substring must be a string");
    return _unwrap(string).contains(substring);
}
$contains = contains;

#| property strings.length: (string: string) -> number
#| Returns the length of the string in unicode code units
#| @method string
function length(string) {
    return _unwrap(string).length();
}
$length = length;

#| property strings.isEmpty: (string: string) -> boolean
#| Returns true if the string is empty (length == 0)
#| @method string
function isEmpty(string) {
    return _unwrap(string).isEmpty();
}
$isEmpty = isEmpty;

#| property strings.isBlank: (string: string) -> boolean
#| Returns true if the string only contains whitespace characters
#| @method string
function isBlank(string) {
    return _unwrap(string).isBlank();
}
$isBlank = isBlank;

#| property strings.charAt: (string: string, index: number) -> string
#| Returns a string consisting of only the character at the specified index
#| @method string
function charAt(string, index) {
    return _unwrap(string).charAt(index);
}
$charAt = charAt;

#| property strings.chars: (string: string) -> array
#| Returns an array of strings with each character from this string
#| @method string
function chars(string) {
    val jArray = _unwrap(string).toCharArray();
    val array = [];
    for (var i = 0; i < jArray.length; i++) {
        array.push(jArray[i]);
    }
    return array;
}
$chars = chars;

#| property strings.substring: (string: string, from: number, to: number?) -> string
#| Returns a substring from the specified start index (inclusive) to the specified end index, if specified (exclusive)
#| @method string
function substring(string, from, to = null) {
    if (to == null) {
        return _unwrap(string).'substring(I)Ljava/lang/String;'(from);
    } else {
        return _unwrap(string).'substring(II)Ljava/lang/String;'(from, to);
    }
}
$substring = substring;

# We don't want to expose join or asString, so we do this first. defineMethods copies the object
internals.defineMethods("string", $);

#| property strings.join: (array: array, string: delimiter) -> string
#| Converts all values in the array to a string and concatenates them with the delimiter in between
function join(array, delimiter) {
    debug.assert(array is array, "First argument to join must be an array");
    debug.assert(delimiter is string, "Second argument to join must be a string");
    
    if (array.length == 0) return;

    var result = asString(array[0]);
    for (var i = 1; i < array.length; i++) {
        result += delimiter + asString(array[i]);
    }

    return result;
}
$join = join;
