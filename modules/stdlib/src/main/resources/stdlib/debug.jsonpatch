import "@internals" as internals;

# @@doc_namespace std

#| global library debug
#| Provides various functions for debugging code.

#| property debug.log: (message: any) -> null
#| Logs a message to console.
function log(value) {
    internals.log(value);
}

#| property debug.throw: (message: any) -> null
#| Throws an error. Use this if your code gets in situations it shouldn't.
function throw(value) {
    internals._throw(value);
}

#| property debug.assert: (value: any, message: string?) -> null
#| Checks if the value is truthy. If it is nothing happens. If it isn't, then an error is thrown.
function assert(value, message = "Asserting failed") {
    if (!value) {
        throw(message);
    }
}

#| property debug.assertEquals: (first: any, second: any) -> null
#| Checks if the two values are equal. If they are nothing happens. If they aren't, then an error is thrown.
function assertEquals(first, second) {
    if (first != second) {
        throw("Assertion failed: " + strings.asString(first) + " != " + strings.asString(second));
    }
}

$log = log;
$throw = throw;
$assert = assert;
$assertEquals = assertEquals;
