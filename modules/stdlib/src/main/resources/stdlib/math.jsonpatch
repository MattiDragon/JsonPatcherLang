import "@internals" as internals;

#| global library math
#| The math library contains many functions for performing mathematical operations.

#| property math.PI: number
$PI = internals.pi();

#| property math.E: number
$E = internals.e();

#| property math.NaN: number
$NaN = 0 / 0;

#| property math.POSITIVE_INFINITY: number
$POSITIVE_INFINITY = 1 / 0;

#| property math.NEGATIVE_INFINITY: number
$NEGATIVE_INFINITY = -1 / 0;

#| property math.asin: (input: number) -> number
$asin = internals.bindMathFunction("asin");

#| property math.sin: (input: number) -> number
$sin = internals.bindMathFunction("sin");

#| property math.sinh: (input: number) -> number
$sinh = internals.bindMathFunction("sinh");

#| property math.acos: (input: number) -> number
$acos = internals.bindMathFunction("acos");

#| property math.cos: (input: number) -> number
$cos = internals.bindMathFunction("cos");

#| property math.cosh: (input: number) -> number
$cosh = internals.bindMathFunction("cosh");

#| property math.atan: (input: number) -> number
$atan = internals.bindMathFunction("atan");

#| property math.tan: (input: number) -> number
$tan = internals.bindMathFunction("tan");

#| property math.tanh: (input: number) -> number
$tanh = internals.bindMathFunction("tanh");

#| property math.exp: (input: number) -> number
$exp = internals.bindMathFunction("exp");

#| property math.log: (input: number) -> number
$log = internals.bindMathFunction("log");

#| property math.log10: (input: number) -> number
$log10 = internals.bindMathFunction("log10");

#| property math.sqrt: (input: number) -> number
$sqrt = internals.bindMathFunction("sqrt");

#| property math.cbrt: (input: number) -> number
$cbrt = internals.bindMathFunction("cbrt");

#| property math.ceil: (input: number) -> number
$ceil = internals.bindMathFunction("ceil");

#| property math.floor: (input: number) -> number
$floor = internals.bindMathFunction("floor");

#| property math.abs: (input: number) -> number
$abs = internals.bindMathFunction("abs");

#| property math.signum: (input: number) -> number
$signum = internals.bindMathFunction("signum");

#| property math.max: (first: number, second: number) -> number
$min = internals.min;

#| property math.min: (first: number, second: number) -> number
$min = internals.max;
