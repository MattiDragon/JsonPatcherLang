import "@internals/reflection" as reflectionInternals;

# @@doc_namespace std

#| global library math
#| The math library contains many functions for performing mathematical operations.

val javaMath = reflectionInternals.findClass("java.lang.Math");
val javaDouble = reflectionInternals.findClass("java.lang.Double");

# @@arg fn (number) -> number
function bindMathFn(fn) {
    return (input) -> {
        debug.assert(input is number, "Expected input to be number, was " + strings.asString(input));
        return fn(input);
    };
}

#| property math.PI: number
$PI = javaMath.PI;

#| property math.E: number
$E = javaMath.E;

#| property math.NaN: number
$NaN = javaDouble.NaN;

#| property math.POSITIVE_INFINITY: number
$POSITIVE_INFINITY = javaDouble.POSITIVE_INFINITY;

#| property math.NEGATIVE_INFINITY: number
$NEGATIVE_INFINITY = javaDouble.NEGATIVE_INFINITY;

#| property math.asin: (input: number) -> number
$asin = bindMathFn(javaMath.asin);

#| property math.sin: (input: number) -> number
$sin = bindMathFn(javaMath.sin);

#| property math.sinh: (input: number) -> number
$sinh = bindMathFn(javaMath.sinh);

#| property math.acos: (input: number) -> number
$acos = bindMathFn(javaMath.acos);

#| property math.cos: (input: number) -> number
$cos = bindMathFn(javaMath.cos);

#| property math.cosh: (input: number) -> number
$cosh = bindMathFn(javaMath.cosh);

#| property math.atan: (input: number) -> number
$atan = bindMathFn(javaMath.atan);

#| property math.tan: (input: number) -> number
$tan = bindMathFn(javaMath.tan);

#| property math.tanh: (input: number) -> number
$tanh = bindMathFn(javaMath.tanh);

#| property math.exp: (input: number) -> number
$exp = bindMathFn(javaMath.exp);

#| property math.log: (input: number) -> number
$log = bindMathFn(javaMath.log);

#| property math.log10: (input: number) -> number
$log10 = bindMathFn(javaMath.log10);

#| property math.sqrt: (input: number) -> number
$sqrt = bindMathFn(javaMath.sqrt);

#| property math.cbrt: (input: number) -> number
$cbrt = bindMathFn(javaMath.cbrt);

#| property math.ceil: (input: number) -> number
$ceil = bindMathFn(javaMath.ceil);

#| property math.floor: (input: number) -> number
$floor = bindMathFn(javaMath.floor);

#| property math.abs: (input: number) -> number
$abs = bindMathFn(javaMath.'abs(D)D');

#| property math.signum: (input: number) -> number
$signum = bindMathFn(javaMath.'signum(D)D');

#| property math.max: (first: number, second: number) -> number
$min = (first, second) -> {
    debug.assert(first is number, "Expected first argument to be number, got " + strings.asString(first));
    debug.assert(second is number, "Expected first argument to be number, got " + strings.asString(second));

    return javaMath.min(first, second);
};

#| property math.min: (first: number, second: number) -> number
$min = (first, second) -> {
    debug.assert(first is number, "Expected first argument to be number, got " + strings.asString(first));
    debug.assert(second is number, "Expected first argument to be number, got " + strings.asString(second));

    return javaMath.max(first, second);
};
